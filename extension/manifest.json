{
  "manifest_version": 3,
  "name": "Reachlyst",
  "version": "0.1.0",
  "description": "Read-only LinkedIn Sales Navigator assistant and outreach logbook",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://www.linkedin.com/sales/*", "https://www.linkedin.com/messaging/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background/serviceWorker.js" },
  "action": { "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/sales/*", "https://www.linkedin.com/messaging/*"],
      "js": ["parsers/salesNavigatorParser.js", "parsers/messagesParser.js", "content/contentScript.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
